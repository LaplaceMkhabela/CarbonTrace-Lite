# CarbonTrace Lite environment
# Set USE_MOCK_DATA=true for demo mode (no API keys needed).
# Set to false to use live Sentinel Hub + OpenWeather APIs.
USE_MOCK_DATA=true

# Sentinel Hub (https://www.sentinel-hub.com/) client credentials
SH_CLIENT_ID=
SH_CLIENT_SECRET=
SH_INSTANCE_ID=

# OpenWeather (https://openweathermap.org/api) API key
OPENWEATHER_API_KEY=

# Claim signing + on-chain (Phase 3)
# Live attestation activates when POLYGON_RPC_URL + PRIVATE_KEY +
# CONTRACT_ADDRESS are all set. Set USE_LIVE_CHAIN=false to force offline
# simulated mode even with keys present.
USE_LIVE_CHAIN=
PRIVATE_KEY=
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
CONTRACT_ADDRESS=
# Community account that receives minted CTC on-chain (defaults to "community")
COMMUNITY_ADDRESS=