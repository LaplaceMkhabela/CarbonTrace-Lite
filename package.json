{
  "name": "carbontrace-lite",
  "version": "0.1.0",
  "private": true,
  "description": "CarbonTrace Lite — a verifiable community carbon ledger. Cross-checks community-reported environmental actions against independent data sources and scores them for on-chain carbon credits.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify-cli.ts",
    "train": "tsx scripts/train-model.ts",
    "compile": "tsx scripts/compile-contract.ts",
    "deploy": "tsx scripts/deploy-contract.ts",
    "submit": "tsx scripts/submit-claim.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.17.0",
    "leaflet": "^1.9.4",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "solc": "^0.8.26",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.21",
    "vitest": "^2.0.0"
  }
}
